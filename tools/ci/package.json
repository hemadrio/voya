{
  "name": "@travel/ci-tools",
  "version": "0.1.0",
  "private": true,
  "description": "CI pipeline tools — migration linter, compatibility gate, affected-graph resolver, coverage gate, and image-tag generator.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "lint": "echo 'no lint for ci-tools'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "affected": "tsx affected.ts",
    "coverage-gate": "tsx coverage-gate.ts",
    "image-tag": "tsx image-tag.ts",
    "rollback": "tsx rollback.ts",
    "approval-check": "tsx approval-check.ts",
    "smoke": "tsx smoke.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
