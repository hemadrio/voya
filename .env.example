# =============================================================================
# .env.example — environment template for the travel platform
#
# SETUP: Copy this file to .env and fill in values for local development.
#        The bootstrap script does this automatically:
#          ./scripts/bootstrap.sh
#
# RULES:
#   - Never commit real credentials to this file or to .env.
#   - All values here are development placeholders only.
#   - The startup validator rejects these placeholder values in staging/production.
#   - Required=yes means the service exits non-zero on startup if the variable
#     is absent or holds a placeholder value outside of NODE_ENV=development.
# =============================================================================

# ── Node environment (all services) ──────────────────────────────────────────
# Required: yes | Owner: all services
# One of: development, test, staging, production
NODE_ENV=development

# ── Logging (all services) ────────────────────────────────────────────────────
# Required: no (default: info) | Owner: all services
# One of: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info

# =============================================================================
# INFRASTRUCTURE — local Compose stack connection strings
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Required: yes (DB-connected services) | Owner: auth, booking, payment, user,
#           itinerary, reporting, notification-consumer
# Must include connection_limit=5 to match RDS Proxy ceiling (enforced at startup)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_dev?connection_limit=5&pool_timeout=10&sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required: yes | Owner: api-gateway, flight, hotel, car, booking, ai, notification
REDIS_URL=redis://localhost:6379

# ── RabbitMQ (local queue driver — production uses SQS) ──────────────────────
# Required: no (omit to disable queue-backed features locally) | Owner: booking, notification
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_DRIVER=rabbitmq

# ── SQS (local LocalStack — only needed with --profile aws) ──────────────────
# Required: no (local) | Owner: booking, payment, notification-consumer
# Production value is injected from Terraform SQS module output.
SQS_QUEUE_URL=http://localhost:4566/000000000000/travel-notifications.fifo

# =============================================================================
# AUTHENTICATION & SESSION
# =============================================================================

# ── JWT signing key (auth-service only) ───────────────────────────────────────
# Required: yes | Owner: auth-service
# Generate with: openssl rand -base64 64
# Must be at least 32 characters. The startup validator rejects placeholders in
# non-development environments.
JWT_SECRET=dev-local-jwt-secret-replace-before-deploying-to-staging-or-prod

# ── JWT public key (all services that verify tokens) ─────────────────────────
# Required: yes | Owner: api-gateway, user, booking, payment, ai, itinerary, reporting
# RS256 SPKI PEM. Must match the signing key in auth-service.
# Generate with: openssl genrsa 2048 | openssl rsa -pubout
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEADEVPLACEHOLDER\n-----END PUBLIC KEY-----

# ── Google OAuth (auth-service only — optional locally) ───────────────────────
# Required: no (local) | Owner: auth-service
# Obtain from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=<replace-with-google-client-id>
GOOGLE_CLIENT_SECRET=<replace-with-google-client-secret>

# =============================================================================
# PAYMENT (payment-service only)
# =============================================================================

# ── Stripe API key ────────────────────────────────────────────────────────────
# Required: yes | Owner: payment-service
# Use test-mode keys (sk_test_*) for local development.
STRIPE_SECRET_KEY=sk_test_<replace-with-stripe-test-key>

# ── Stripe webhook signing secret ─────────────────────────────────────────────
# Required: yes | Owner: payment-service
# Obtain from: Stripe Dashboard → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_<replace-with-stripe-webhook-secret>

# =============================================================================
# SUPPLIER INTEGRATIONS
# =============================================================================

# ── Amadeus GDS (flight-service only) ─────────────────────────────────────────
# Required: no (local/dev) | Owner: flight-service
# Services degrade to mock results when absent in development.
# Obtain from: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=<replace-with-amadeus-client-id>
AMADEUS_CLIENT_SECRET=<replace-with-amadeus-client-secret>

# ── RapidAPI (hotel-service, car-service) ─────────────────────────────────────
# Required: no (local/dev) | Owner: hotel-service, car-service
# Services degrade to mock results when absent in development.
# Obtain from: https://rapidapi.com/
RAPIDAPI_KEY=<replace-with-rapidapi-key>

# =============================================================================
# AI ORCHESTRATION (ai-service only)
# =============================================================================

# ── Anthropic Claude API key ──────────────────────────────────────────────────
# Required: yes | Owner: ai-service
ANTHROPIC_API_KEY=<replace-with-anthropic-api-key>

# =============================================================================
# NOTIFICATIONS (notification-consumer only)
# =============================================================================

# ── SES sender address ────────────────────────────────────────────────────────
# Required: yes | Owner: notification-consumer
# Must be a verified identity in SES (or LocalStack for local dev).
SES_FROM_ADDRESS=noreply@travel.local

# =============================================================================
# FRONTEND (web application only)
# =============================================================================

# ── API gateway base URL ──────────────────────────────────────────────────────
# Required: yes | Owner: frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Session secret (server-only) ─────────────────────────────────────────────
# Required: no (optional in dev) | Owner: frontend
# Must be at least 32 characters when set.
SESSION_SECRET=dev-session-secret-replace-before-deploying-to-staging-or-prod

# =============================================================================
# AWS (LocalStack emulation — only used with: docker compose --profile aws up)
# =============================================================================

AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-west-1

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Required: no (traces are dropped silently when unset) | Owner: all services
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=travel-platform-local

# =============================================================================
# TURBOREPO REMOTE CACHE (CI only — never commit real values)
# =============================================================================

# TURBO_TOKEN=<remote-cache-access-token>
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=<signing-secret>
# TURBO_TEAM=<your-team-slug>
# TURBO_API=https://vercel.com
