# ============================================================
# .env.example — environment template for the travel platform
# Copy to .env.local and fill in the blanks for local dev.
# NEVER commit real credentials to this file.
# ============================================================

# ── Node environment ─────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL via local Compose stack) ────────────
DATABASE_URL=postgresql://travel_app:travel_app_password@localhost:5432/travel_local

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── LocalStack (AWS emulation) ───────────────────────────────
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ── JWT / Auth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SIGNING_KEY=<replace-with-generated-key>

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_<replace>
STRIPE_WEBHOOK_SECRET=whsec_<replace>

# ── Amadeus supplier ─────────────────────────────────────────
AMADEUS_CLIENT_ID=<replace>
AMADEUS_CLIENT_SECRET=<replace>

# ── RapidAPI supplier ────────────────────────────────────────
RAPIDAPI_KEY=<replace>

# ── Anthropic AI ─────────────────────────────────────────────
ANTHROPIC_API_KEY=<replace>

# ── Turborepo remote cache ───────────────────────────────────
# Set both in CI; leave unset locally to fall back to local cache.
# TURBO_TOKEN=<remote-cache-access-token>          # never commit
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=<signing-secret> # never commit
# TURBO_TEAM=<your-team-slug>
# TURBO_API=https://vercel.com

# ── OpenTelemetry ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=travel-platform-local
