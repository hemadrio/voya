{
  "name": "travel-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered multi-supplier travel booking platform monorepo (pnpm workspaces + Turborepo).",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "preinstall": "node scripts/preinstall.cjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "contract:gen": "turbo run contract:gen",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "workspace:lint": "tsx tools/workspace-lint/src/index.ts",
    "coverage:check": "tsx scripts/coverage-check.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "bash scripts/db-reset.sh"
  },
  "devDependencies": {
    "turbo": "2.1.3",
    "tsx": "^4.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
