# pnpm workspace settings
# ---------------------------------------------------------------------------

# Enforce that all peer dependencies are explicitly declared; surface peer
# conflicts at install time rather than at runtime.
strict-peer-dependencies=true

# Never auto-install missing peer dependencies — explicit declarations only.
auto-install-peers=false

# Prevent phantom-dependency usage: packages may only import what they declare.
# Symlink-based node_modules means unlisted deps are invisible.
shamefully-hoist=false
public-hoist-pattern=[]

# Fail if the lockfile is out of date (set in CI via FROZEN_LOCKFILE or --frozen-lockfile flag).
# Locally, pnpm install updates the lockfile as expected.
# CI pipeline must pass --frozen-lockfile or set this:
# frozen-lockfile=true

# Do not run lifecycle scripts from packages that have not been vetted.
# Exceptions: add to the allow list below when a post-install script is required.
ignore-scripts=false

# Engine check: respect the engines field in package manifests.
engine-strict=true
