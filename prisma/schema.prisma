// Canonical Prisma schema — single source of truth for the travel platform.
// All nine services reference this shared schema.
//
// Migration strategy: expand/contract — every change in this file must be
// additive for one full release cycle (no column drop, rename or type
// narrowing) so the previous service version keeps working against the
// migrated database.
//
// Append-only enforcement, role-level REVOKE/GRANT and trigger functions
// that Prisma cannot express are delivered as raw SQL appended to the
// generated migration file.

// ---------------------------------------------------------------------------
// UserRole — authorization role enum (WO-014)
// ---------------------------------------------------------------------------

enum UserRole {
  traveler
  support_agent
  system
}

// ---------------------------------------------------------------------------
// UserStatus — account lifecycle state (WO-018)
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  pending
  suspended
  deleted
}

// ---------------------------------------------------------------------------
// CredentialType — credential kind (WO-018)
// ---------------------------------------------------------------------------

enum CredentialType {
  password
  oauth
  totp
}

// ---------------------------------------------------------------------------
// SuppressionReason — email suppression source (WO-052)
// ---------------------------------------------------------------------------

enum SuppressionReason {
  BOUNCE
  COMPLAINT
  MANUAL
}

// ---------------------------------------------------------------------------
// DataClassification — four-tier classification enum (WO-074)
// ---------------------------------------------------------------------------

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(traveler)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // WO-024 additions — lockout state cleared on successful password reset
  failedAttemptCount Int       @default(0) @map("failed_attempt_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz

  // WO-074 additions — data classification and purge metadata
  /// Data classification tier for this row (RESTRICTED for identity data).
  classification     DataClassification @default(RESTRICTED) @map("classification")
  /// Timestamp when a GDPR erasure request was received; null while account is live.
  /// purge_after = erasure_requested_at + RETENTION_ACCOUNT_IDENTITY_DAYS days.
  erasureRequestedAt DateTime?  @map("erasure_requested_at") @db.Timestamptz
  /// Computed purge timestamp; null until an erasure request is fulfilled.
  purgeAfter         DateTime?  @map("purge_after") @db.Timestamptz

  // WO-018 additions — identity schema
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  displayName     String?    @map("display_name") @db.VarChar(128)
  status          UserStatus @default(pending) @map("status")

  bookings      Booking[]
  sessions      Session[]
  oneTimeTokens OneTimeToken[]
  preferences   TravelPreference?
  itineraries   Itinerary[]
  credentials   Credential[]
  userRoles     UserRoleEntry[]

  @@index([purgeAfter], map: "idx_users_purge_after")
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // WO-024 additions — all nullable for backward compatibility with existing rows
  refreshTokenHash String?   @map("refresh_token_hash")
  familyId         String?   @map("family_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz

  // WO-018 addition — nullable self-reference preserving refresh-token rotation chain
  rotatedFromSessionId String?  @map("rotated_from_session_id") @db.Uuid

  // WO-022 addition — absolute session lifetime (never extended by rotation)
  /// The wall-clock deadline beyond which this session may not be refreshed,
  /// regardless of recent activity.  Copied verbatim from the parent session
  /// on every rotation so clock drift cannot extend the absolute lifetime.
  absoluteExpiresAt DateTime? @map("absolute_expires_at") @db.Timestamptz

  // WO-074 additions
  /// Data classification tier (RESTRICTED — contains token hashes and IP).
  classification DataClassification @default(RESTRICTED) @map("classification")
  /// purge_after = expires_at + RETENTION_SESSION_DAYS days.
  purgeAfter     DateTime?          @map("purge_after") @db.Timestamptz

  user                User     @relation(fields: [userId], references: [id])
  rotatedFromSession  Session? @relation("SessionRotation", fields: [rotatedFromSessionId], references: [id])
  rotatedSessions     Session[] @relation("SessionRotation")

  @@index([userId, revokedAt], map: "idx_sessions_user_revoked")
  // WO-077: unique index on refresh_token_hash (WHERE refresh_token_hash IS NOT NULL
  // via partial index — created in raw SQL migration 0006).
  @@index([refreshTokenHash], map: "uq_sessions_refresh_token_hash")
  // WO-077: session expiry sweep and purge candidate query
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([purgeAfter], map: "idx_sessions_purge_after")
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// OneTimeToken — single-use hashed tokens for password reset and verification
// ---------------------------------------------------------------------------

/// Single-use hashed tokens for password reset (and future purposes).
///
/// Only the SHA-256 hash of the raw token is stored — the raw value is
/// never persisted and must never appear in logs or responses.
///
/// consumed_at is set atomically when the token is first used; subsequent
/// attempts to use a token with a non-null consumed_at are rejected.
model OneTimeToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String    @db.VarChar(64)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // WO-074 additions
  classification DataClassification @default(RESTRICTED) @map("classification")
  /// purge_after = expires_at + RETENTION_SESSION_DAYS days.
  purgeAfter     DateTime?          @map("purge_after") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose, consumedAt], map: "idx_ott_user_purpose_consumed")
  @@index([purgeAfter], map: "idx_ott_purge_after")
  @@map("one_time_tokens")
}

// ---------------------------------------------------------------------------
// Booking
// ---------------------------------------------------------------------------

/// Booking row — represents a single purchased travel segment.
///
/// WO-072 additions (additive, backward-compatible):
///   provenance  — tracks which supplier channel produced the booked offer.
///   bookable    — structural flag; defaults to false; must be true for
///                 any offer that enters the PENDING state.
model Booking {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  bookingType  String   @map("booking_type")
  status       String   @default("PENDING")
  offerId      String   @map("offer_id")
  totalPrice   Decimal  @map("total_price") @db.Decimal(12, 2)
  currency     String   @db.Char(3)
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  idempotencyKey String @unique @map("idempotency_key")
  /// Snapshot of the offer as presented at selection time. Stored as JSONB.
  searchResultSnapshot Json? @map("search_result_snapshot") @db.Json

  // WO-072 additions — nullable so previous-version rows without this
  // column stay valid until the application backfills them.
  /// Supplier channel that produced the booked offer.
  provenance String? @db.VarChar(64)
  /// True only when the offer came from a real supplier (not ILLUSTRATIVE).
  bookable   Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // WO-077: nullable expiry timestamp for PENDING bookings (set on create,
  // NULL after confirmation/cancellation). Drives the pending-expiry sweep.
  /// Timestamp at which a PENDING booking is considered abandoned.
  /// Set to created_at + 30 minutes on INSERT; NULL once the booking moves
  /// to CONFIRMED or CANCELLED.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  user       User              @relation(fields: [userId], references: [id])
  auditLogs  BookingAuditLog[]
  travelers  BookingTraveler[]

  // WO-073: nullable marker set by the backfill job when all passengers have
  // been migrated to booking_travelers; null means the row has not yet been
  // processed by the backfill.
  travelersMigratedAt DateTime? @map("travelers_migrated_at") @db.Timestamptz

  // WO-074 additions
  /// Data classification tier (CONFIDENTIAL — booking transaction data).
  classification DataClassification @default(CONFIDENTIAL) @map("classification")
  /// purge_after = created_at + RETENTION_TRANSACTION_YEARS years.
  /// A cancelled booking keeps the same horizon (tax/dispute retention).
  purgeAfter     DateTime?          @map("purge_after") @db.Timestamptz

  @@index([userId])
  @@index([status])
  // WO-077: composite index for booking history list (user_id, created_at DESC)
  @@index([userId, createdAt(sort: Desc)], map: "idx_bookings_user_created_at")
  // WO-077: ownership read (id, user_id) for deny-by-default WHERE id=$1 AND user_id=$2
  @@index([id, userId], map: "idx_bookings_ownership")
  // WO-077: pending expiry sweep — physical partial index (status, expires_at)
  // WHERE status = 'PENDING' is created via raw SQL in migration 0006.
  @@index([status, expiresAt], map: "idx_bookings_pending_expiry")
  @@index([travelersMigratedAt], map: "idx_bookings_travelers_migrated_at")
  @@index([purgeAfter], map: "idx_bookings_purge_after")
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// BookingAuditLog — append-only via trigger (see migration SQL)
// ---------------------------------------------------------------------------

/// Append-only audit log for booking state transitions.
///
/// WO-072 additions (additive, backward-compatible):
///   actorId, actorRole, resourceType, resourceId — who changed what.
///   occurredAt — wall-clock time of the change.
///   sequence   — BIGSERIAL identity column for deterministic ordering.
///
/// All new columns are nullable or defaulted so a previous-version service
/// that omits them still produces valid INSERT rows.
///
/// Append-only enforcement is implemented as a database trigger + REVOKE:
///   - The application role cannot execute UPDATE or DELETE.
///   - A BEFORE UPDATE OR DELETE trigger RAISES EXCEPTION as a defence-in-depth
///     guard even if the REVOKE is accidentally relaxed.
///
/// Audit payload minimisation: previous_state and new_state are written
/// through sanitiseAuditPayload() before persistence so no PII ever enters
/// this table (audit rows are excluded from GDPR erasure and retained ≥ 1 yr).
model BookingAuditLog {
  id       String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  // Original columns (kept unchanged for backward compat)
  action        String
  previousState Json?  @map("previous_state") @db.JsonB
  newState      Json?  @map("new_state") @db.JsonB
  changedBy     String? @map("changed_by")
  timestamp     DateTime @default(now()) @db.Timestamptz

  // WO-072 additions
  /// Authenticated user or system identity that caused the change.
  actorId      String?  @map("actor_id") @db.VarChar(128)
  /// Role of the actor (traveler | support_agent | ops | system).
  actorRole    String?  @map("actor_role") @db.VarChar(32)
  /// Domain resource type (e.g. "booking").
  resourceType String?  @map("resource_type") @db.VarChar(64)
  /// Domain resource identifier (booking UUID).
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  /// Wall-clock time of the state transition.
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  /// Monotonically ordered identity column for deterministic replay.
  sequence     BigInt?  @map("sequence")

  // WO-101 additions — hash-chain columns
  /// SHA-256 hash of the previous entry for the same resource stream.
  /// GENESIS_HASH sentinel ("0000...") for the first entry.
  prevHash      String?  @map("prev_hash") @db.Char(64)
  /// SHA-256 hash of canonical(payload) + prev_hash.
  entryHash     String?  @map("entry_hash") @db.Char(64)
  /// Distributed trace / request correlation identifier.
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  /// IPv4/IPv6 of the actor's originating request.
  actorIp       String?  @map("actor_ip") @db.VarChar(64)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([resourceId, occurredAt], map: "idx_audit_resource_occurred")
  @@index([actorId, occurredAt], map: "idx_booking_audit_actor_occurred")
  @@map("booking_audit_log")
}

// ---------------------------------------------------------------------------
// AuthAuditLog — append-only authentication audit trail (WO-101)
// ---------------------------------------------------------------------------

/// Immutable audit trail for every authentication and authorization event.
///
/// Append-only enforcement mirrors booking_audit_log:
///   - REVOKE UPDATE, DELETE from application role (migration 0012).
///   - BEFORE UPDATE/DELETE trigger raises EXCEPTION as defence in depth.
///
/// Hash chain: entry_hash = SHA-256(canonical(payload) + prev_hash).
/// Stream key: resource_id (user UUID), or actor_ip hash for anonymous events.
///
/// Excluded from GDPR erasure; erasure pseudonymises actor_id instead.
model AuthAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String   @map("actor_id") @db.VarChar(128)
  actorRole     String   @map("actor_role") @db.VarChar(32)
  /// IPv4/IPv6 of the actor's originating request.
  actorIp       String?  @map("actor_ip") @db.VarChar(64)
  action        String
  resourceType  String   @map("resource_type") @db.VarChar(64)
  resourceId    String   @map("resource_id") @db.VarChar(128)
  previousState Json?    @map("previous_state") @db.JsonB
  newState      Json?    @map("new_state") @db.JsonB
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  sequence      BigInt?  @map("sequence")
  /// SHA-256 hash of the previous entry for the same resource stream.
  prevHash      String?  @map("prev_hash") @db.Char(64)
  /// SHA-256 hash of canonical(payload) + prev_hash.
  entryHash     String?  @map("entry_hash") @db.Char(64)

  @@index([resourceId, occurredAt], map: "idx_auth_audit_resource_occurred")
  @@index([actorId, occurredAt], map: "idx_auth_audit_actor_occurred")
  @@map("auth_audit_log")
}

// ---------------------------------------------------------------------------
// ProcessedEvent — idempotency table for inbound webhook events (WO-072)
// ---------------------------------------------------------------------------

/// Durable idempotency store for Stripe (and future provider) webhooks.
///
/// The unique constraint on (provider, event_id) is the exactly-once
/// authority for BR-03: an event that arrives twice (Stripe redelivery,
/// concurrent tasks) is detected here before any side-effect is applied.
///
/// payload_digest stores the SHA-256 of the raw event body so a second
/// delivery with a mutated body can be detected forensically without
/// storing the full payload.
model ProcessedEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @db.VarChar(64)
  eventId     String    @map("event_id") @db.VarChar(256)
  eventType   String    @map("event_type") @db.VarChar(128)
  payloadDigest String  @map("payload_digest") @db.Char(64)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  @@unique([provider, eventId], map: "uq_processed_events_provider_event")
  @@index([receivedAt], map: "idx_processed_events_received_at")
  @@map("processed_events")
}

// ---------------------------------------------------------------------------
// NotificationProcessedEvent — exactly-once authority for notification consumer (WO-052)
// ---------------------------------------------------------------------------

/// Durable idempotency store for the notification consumer.
///
/// The unique constraint on (provider, event_id) is the authority for
/// exactly-once SES delivery: a P2002 insert conflict means the event was
/// already handled and the current delivery is a duplicate; the consumer acks
/// without sending a second email.
///
/// This is a separate model from ProcessedEvent (payment webhooks) so the
/// notification consumer can be migrated, retained, and archived independently.
model NotificationProcessedEvent {
  id            String   @id @default(uuid()) @db.Uuid
  provider      String   @db.VarChar(64)
  eventId       String   @map("event_id") @db.VarChar(256)
  handler       String   @db.VarChar(128)
  correlationId String   @map("correlation_id") @db.VarChar(256)
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@unique([provider, eventId], map: "uq_notification_processed_event_provider_event")
  @@index([processedAt], map: "idx_notification_processed_event_processed_at")
  @@map("notification_processed_events")
}

// ---------------------------------------------------------------------------
// BookingTraveler — normalized traveler identity with KMS envelope encryption
// (WO-073)
// ---------------------------------------------------------------------------

/// Per-booking traveler row extracted from the legacy Booking.passengers JSON.
///
/// The two Restricted fields (date of birth, passport reference) are stored as
/// KMS-enveloped AES-256-GCM ciphertext.  The wrapped DEK is scoped
/// per-subject (one per row) so cryptographic erasure is achieved by
/// overwriting or deleting `wrapped_dek` — no CMK rotation required.
///
/// Column-level access:
///   booking-service role: full access (SELECT, INSERT)
///   support_agent role:   SELECT on all columns EXCEPT encrypted_date_of_birth
///                         and encrypted_passport_reference (enforced by migration)
///
/// The legacy Booking.passengers column is NOT dropped in this story.
model BookingTraveler {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid

  /// Plaintext traveler name fields (not Restricted under PII policy)
  givenName   String   @map("given_name")
  familyName  String   @map("family_name")
  email       String?

  /// AES-256-GCM ciphertext of the date of birth string (YYYY-MM-DD).
  /// Null when the source passenger had no dateOfBirth (should not occur but
  /// the backfill must not crash on a malformed element).
  encryptedDateOfBirth      Bytes? @map("encrypted_date_of_birth")
  encryptedDobIv            Bytes? @map("encrypted_dob_iv")

  /// AES-256-GCM ciphertext of the passport number.
  /// Null when the source passenger had no passportNumber.
  encryptedPassportReference Bytes? @map("encrypted_passport_reference")
  encryptedPassportIv        Bytes? @map("encrypted_passport_iv")

  /// KMS-wrapped data encryption key (output of GenerateDataKey CiphertextBlob).
  wrappedDek  Bytes    @map("wrapped_dek")
  /// ARN/ID of the KMS CMK used to wrap the DEK.
  dekKeyId    String   @map("dek_key_id") @db.VarChar(2048)
  /// Encryption context bound at encrypt time — must match verbatim on Decrypt.
  encryptionContext Json @map("encryption_context") @db.JsonB

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // WO-074 additions
  /// Data classification tier (RESTRICTED — identity documents).
  classification DataClassification @default(RESTRICTED) @map("classification")
  /// purge_after = trip_completed_at + RETENTION_IDENTITY_DOCUMENT_DAYS days.
  /// Null until the trip has been completed (must not default to now + 90 days).
  purgeAfter     DateTime?          @map("purge_after") @db.Timestamptz
  /// Wall-clock time the associated trip was completed; set by the itinerary service
  /// when the last leg departs. Drives purge_after derivation.
  tripCompletedAt DateTime?         @map("trip_completed_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId], map: "idx_booking_travelers_booking_id")
  @@index([purgeAfter], map: "idx_booking_travelers_purge_after")
  @@map("booking_travelers")
}

// ---------------------------------------------------------------------------
// Itinerary — multi-booking trip plan (WO-074: includes purge metadata)
// ---------------------------------------------------------------------------

/// A named collection of bookings representing a complete trip.
/// Created by the traveler or assembled by the AI assistant.
model Itinerary {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(256)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // WO-074: data classification and purge metadata
  classification DataClassification @default(CONFIDENTIAL) @map("classification")
  /// purge_after = created_at + RETENTION_ITINERARY_YEARS years.
  purgeAfter     DateTime?          @map("purge_after") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([purgeAfter], map: "idx_itineraries_purge_after")
  @@map("itineraries")
}

// ---------------------------------------------------------------------------
// TravelPreference — per-user travel preferences (WO-074: includes purge metadata)
// ---------------------------------------------------------------------------

/// Stored travel preferences per user: seat class, currency, airlines, dietary.
/// One row per user (one-to-one with users).
model TravelPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  preferredSeatClass   String?  @map("preferred_seat_class") @db.VarChar(32)
  preferredCurrency    String?  @map("preferred_currency") @db.Char(3)
  preferredAirlines    String[] @map("preferred_airlines")
  dietaryRestrictions  String[] @map("dietary_restrictions")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // WO-074: data classification and purge metadata
  classification DataClassification @default(CONFIDENTIAL) @map("classification")
  /// purge_after = updated_at + RETENTION_PREFERENCE_DAYS days.
  purgeAfter     DateTime?          @map("purge_after") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([purgeAfter], map: "idx_travel_preferences_purge_after")
  @@map("travel_preferences")
}

// ---------------------------------------------------------------------------
// EmailSuppression — bounce/complaint suppression list (WO-052)
// ---------------------------------------------------------------------------

/// Hard suppression list maintained by the SNS bounce/complaint handler.
///
/// emailHash is the hex-encoded SHA-256 of the lowercase email address so
/// PII is never stored in this table. The hash is compared before every SES
/// send; a match causes the send to be skipped and logged rather than
/// attempted.
model EmailSuppression {
  emailHash     String            @id @map("email_hash") @db.VarChar(64)
  reason        SuppressionReason
  sourceEventId String?           @map("source_event_id") @db.VarChar(256)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@map("email_suppressions")
}

// ---------------------------------------------------------------------------
// SecurityEvent — append-only access-control audit trail (WO-014)
// ---------------------------------------------------------------------------

/// Immutable record of every 403 and actor-context verification failure.
///
/// Application role has INSERT only — UPDATE and DELETE are REVOKED in the
/// migration SQL so no in-process bug or misconfigured credential can alter
/// the audit trail.
///
/// Columns follow the SIEM-consumable naming convention so the CloudWatch
/// metric filter and alarm can match on `decision` = 'DENY' without
/// additional transformation.
model SecurityEvent {
  id           String   @id @default(uuid()) @db.Uuid
  /// Subject ID of the actor making the request (UUID or 'anonymous').
  actorId      String   @map("actor_id") @db.VarChar(128)
  /// Role of the actor at the time of the event.
  actorRole    UserRole @map("actor_role")
  /// Domain resource type (e.g. "booking", "itinerary", "traveler_document").
  resourceType String   @map("resource_type") @db.VarChar(64)
  /// Domain resource identifier (UUID or path segment).
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  /// Operation attempted (e.g. "READ", "CANCEL", "DOCUMENT_READ").
  operation    String   @db.VarChar(64)
  /// Authorization decision: ALLOW or DENY.
  decision     String   @db.VarChar(10)
  /// Human-readable reason for the decision (e.g. "OWNERSHIP_PREDICATE_FAILED").
  reason       String?  @db.VarChar(512)
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([actorId, occurredAt], map: "idx_security_events_actor_occurred")
  @@index([resourceType, resourceId], map: "idx_security_events_resource")
  @@map("security_events")
}

// ---------------------------------------------------------------------------
// Credential — isolated credential store (WO-018)
// ---------------------------------------------------------------------------

/// Stores credential secrets (password hashes, OAuth tokens) separately from
/// the users profile table so profile queries never load secret material.
///
/// secret_hash MUST contain only the output of an approved hashing algorithm
/// (Argon2id for passwords).  Raw plaintext must never appear here.
///
/// Repository select lists must never return secret_hash unless the caller
/// explicitly requests it for credential verification.
model Credential {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  type                CredentialType @default(password)
  secretHash          String         @map("secret_hash")
  hashAlgorithm       String         @default("argon2id") @map("hash_algorithm") @db.VarChar(32)
  failedAttemptCount  Int            @default(0) @map("failed_attempt_count")
  lockedUntil         DateTime?      @map("locked_until") @db.Timestamptz
  lastUsedAt          DateTime?      @map("last_used_at") @db.Timestamptz
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_credentials_user_id")
  @@map("credentials")
}

// ---------------------------------------------------------------------------
// Role / Permission / join tables — RBAC (WO-018)
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(64)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRoleEntry[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(128)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Join table mapping users to roles.  Named UserRoleEntry to avoid
/// collision with the existing UserRole enum (authorization role values).
model UserRoleEntry {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId], map: "idx_user_roles_user_id")
  @@map("user_roles")
}
