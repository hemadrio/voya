{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amountMinor": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "clientSecret": {
      "minLength": 1,
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "paymentId": {
      "minLength": 1,
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "status": {
      "enum": [
        "FAILED",
        "PROCESSING",
        "REFUNDED",
        "REQUIRES_PAYMENT_METHOD",
        "SUCCEEDED"
      ],
      "type": "string"
    }
  },
  "required": [
    "amountMinor",
    "clientSecret",
    "currency",
    "paymentId",
    "status"
  ],
  "schemaId": "payment.PaymentIntentResponse",
  "type": "object"
}
