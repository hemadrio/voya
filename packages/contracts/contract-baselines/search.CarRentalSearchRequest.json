{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "carClass": {
      "enum": [
        "COMPACT",
        "ECONOMY",
        "MIDSIZE",
        "PREMIUM"
      ],
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "dropoffDate": {
      "format": "date-time",
      "type": "string"
    },
    "dropoffLocation": {
      "minLength": 1,
      "type": "string"
    },
    "pickupDate": {
      "format": "date-time",
      "type": "string"
    },
    "pickupLocation": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "carClass",
    "currency",
    "dropoffDate",
    "dropoffLocation",
    "pickupDate",
    "pickupLocation"
  ],
  "schemaId": "search.CarRentalSearchRequest",
  "type": "object"
}
