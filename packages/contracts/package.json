{
  "name": "@travel/contracts",
  "version": "0.1.0",
  "private": false,
  "description": "Single source-of-truth Zod schemas and inferred TypeScript types for every request, response, event, and enum shape shared across the travel platform's services and web app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js",
      "default": "./dist/common/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search/index.js",
      "default": "./dist/search/index.js"
    },
    "./booking": {
      "types": "./dist/booking/index.d.ts",
      "import": "./dist/booking/index.js",
      "default": "./dist/booking/index.js"
    },
    "./payment": {
      "types": "./dist/payment/index.d.ts",
      "import": "./dist/payment/index.js",
      "default": "./dist/payment/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./user": {
      "types": "./dist/user/index.d.ts",
      "import": "./dist/user/index.js",
      "default": "./dist/user/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js",
      "default": "./dist/events/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./traveler": {
      "types": "./dist/traveler.d.ts",
      "import": "./dist/traveler.js",
      "default": "./dist/traveler.js"
    },
    "./retention": {
      "types": "./dist/retention/index.d.ts",
      "import": "./dist/retention/index.js",
      "default": "./dist/retention/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/registry.d.ts",
      "import": "./dist/openapi/registry.js",
      "default": "./dist/openapi/registry.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js",
      "default": "./dist/audit/index.js"
    },
    "./privacy": {
      "types": "./dist/privacy/index.d.ts",
      "import": "./dist/privacy/index.js",
      "default": "./dist/privacy/index.js"
    },
    "./itineraries": {
      "types": "./dist/itineraries/index.d.ts",
      "import": "./dist/itineraries/index.js",
      "default": "./dist/itineraries/index.js"
    },
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "import": "./dist/documents/index.js",
      "default": "./dist/documents/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:deps": "node ./scripts/check-dependency-boundary.mjs",
    "generate:baselines": "tsx scripts/generate-baselines.ts",
    "contracts:compat": "tsx scripts/check-schema-compatibility.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@travel/test-config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
