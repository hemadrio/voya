{
  "name": "@travel/observability",
  "version": "0.1.0",
  "private": false,
  "description": "Pino JSON logger factory with PII redaction for the travel platform. No Express, Prisma, or AWS dependencies — importable by any service including the notification consumer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "test": "jest --config jest.config.cjs",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@opentelemetry/propagator-aws-xray": "catalog:",
    "@opentelemetry/id-generator-aws-xray": "catalog:",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "express": "catalog:",
    "jest": "catalog:",
    "rimraf": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
