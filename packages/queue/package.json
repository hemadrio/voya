{
  "name": "@travel/queue",
  "version": "0.1.0",
  "private": false,
  "description": "QueuePort abstraction with RabbitMQ and SQS adapters for the travel platform async event bus.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "import": "./dist/test/contract/suite.js",
      "types": "./dist/test/contract/suite.d.ts"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=20.0.0 <21.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --config jest.config.cjs",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@travel/contracts": "workspace:*",
    "@aws-sdk/client-sqs": "catalog:",
    "amqplib": "catalog:"
  },
  "devDependencies": {
    "@types/amqplib": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "rimraf": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
